
# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview  # or gpt-3.5-turbo

# Application Settings
DEBUG=False
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# UI Configuration
WINDOW_WIDTH=1280
WINDOW_HEIGHT=800
THEME=light  # light or dark

# Storage Settings
SAVE_DIR=./saved_tools
LOGS_DIR=./logs

# Function Testing
MAX_TEST_DURATION=30  # maximum seconds for function test execution
SAFE_MODE=True  # restrict certain operations during testing
